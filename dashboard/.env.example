# Dashboard configuration — reference.
#
# Nothing loads this file automatically (there is no dotenv dependency, and the
# dashboard image holds a Kubernetes token, so its dependency surface is kept
# minimal). It documents every variable the dashboard reads, and doubles as a
# starting point for running locally:
#
#   cp dashboard/.env.example dashboard/.env      # .env is gitignored
#   set -a; . ./dashboard/.env; set +a
#   node dashboard/server.js
#
# In the cluster these come from k8s/dashboard.yaml (env) and the
# claude-config-s3-rw Secret (envFrom). Keep the two in sync.

# ─── server ──────────────────────────────────────────────────────────────────
PORT=3000
# Namespace to manage workspaces in. In-cluster this is read from the
# ServiceAccount and this value is ignored.
NAMESPACE=dev
# Shown in the UI header. Injected by the Downward API in-cluster.
POD_NAME=local
# Port of the in-pod config shell that /config-tty/ proxies to.
CONFIG_TTY_PORT=7683

# ─── GitHub ──────────────────────────────────────────────────────────────────
# PAT for listing repos/branches. Without it, only GITHUB_USER's public repos
# are listed. Note this token is also handed to every workspace pod.
GITHUB_TOKEN=
GITHUB_USER=edkief
# Secret holding id_rsa + github_token, mounted into workspace pods.
GITHUB_SECRET_NAME=github-ssh-key

# ─── workspace pods ──────────────────────────────────────────────────────────
# Pin to an immutable tag (e.g. :main-<sha>) once the image settles — with
# :latest + Always, every workspace start can pay a multi-GB re-pull.
WORKSPACE_IMAGE=registry.kieffer.me/claude-workstation/workspace:latest
WORKSPACE_IMAGE_PULL_POLICY=Always
CLAUDE_CODE_VERSION=latest

# Requests are what the scheduler packs against; keep them honest and low.
# Limits are the OOM guard that caps one runaway workspace.
WORKSPACE_CPU_REQUEST=250m
WORKSPACE_MEM_REQUEST=1Gi
WORKSPACE_CPU_LIMIT=2
WORKSPACE_MEM_LIMIT=4Gi
# Postgres PGDATA and the Chromium profile live on the node disk, not the PVC,
# so an unbounded workspace can evict its neighbours.
WORKSPACE_EPHEMERAL_REQUEST=2Gi
WORKSPACE_EPHEMERAL_LIMIT=12Gi

# One PVC per repo. Must be a ReadWriteOnce class.
WORKSPACE_STORAGE_CLASS=truenas-iscsi-ssd
WORKSPACE_STORAGE_SIZE=20Gi

# Returns 429 beyond this. The ResourceQuota in k8s/dashboard.yaml is the
# hard backstop.
MAX_WORKSPACES=4

# ─── caching ─────────────────────────────────────────────────────────────────
# Kubernetes is the source of truth; these only throttle polling. The sessions
# cache is bypassed automatically while any pod is starting/terminating, and
# for 10s after any create/delete.
SESSIONS_CACHE_MS=30000
PVC_CACHE_MS=60000
TARGET_CACHE_MS=60000
# How often a PVC may be re-stamped with last-seen-at/last-used-bytes. This
# annotation is the pruner's "untouched for N days" clock; don't make it chatty.
PVC_TOUCH_MS=600000

# ─── shared Claude config (S3 / Garage) ──────────────────────────────────────
# See k8s/secrets.example.yaml. Defaults target Garage, not AWS.
#   any       – any pod may push
#   dashboard – workspaces get read-only S3 credentials; only this shell writes
#   additive  – pods may push skills/, agents/, commands/ only
CONFIG_PUSH_POLICY=any

# Secrets holding the S3 credentials handed to workspace pods. Both are
# provisioned up front so CONFIG_PUSH_POLICY can be flipped without creating
# new cluster objects; the pod template picks -ro whenever the policy is not
# `any`, so the policy is enforced by credentials rather than convention.
CONFIG_S3_SECRET_RW=claude-config-s3-rw
CONFIG_S3_SECRET_RO=claude-config-s3-ro

S3_ENDPOINT=https://garage.kieffer.me
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=claude-config
# Part of the SigV4 credential scope: must match garage.toml's s3_region, or
# requests fail as a signature error.
S3_REGION=garage
# rclone has no `Garage` provider value; `Other` is the correct generic one.
S3_PROVIDER=Other
# Garage serves endpoint/bucket/key, not bucket.endpoint/key.
S3_FORCE_PATH_STYLE=true
S3_PREFIX=config
